# SwachhNetra Backend — Environment Variables

# ── Server ──
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ── Database ──
DATABASE_URL=cleancity.db

# ── Security ──
SECRET_KEY=swachhnetra-gvmc-vizag-2026-CHANGE-THIS-IN-PRODUCTION
TOKEN_EXPIRE_HOURS=8

# ── CORS ──
ALLOWED_ORIGINS=*

# ────────────────────────────────────────────────────────
# FIREBASE (fill these in after creating your project)
# ────────────────────────────────────────────────────────
# Step 1: Create a Firebase project at https://console.firebase.google.com
# Step 2: Go to Project Settings → Service Accounts → Generate New Private Key
# Step 3: Save the downloaded JSON file as serviceAccountKey.json in this folder
# Step 4: Set the path below

FIREBASE_PROJECT_ID=your-project-id-here
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
